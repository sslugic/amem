# Copy to shop/.env (gitignored). Do not commit secrets.
# Prefer pointing at another project's dotenv and letting the shop whitelist
# Mailtrap + Stripe names only — AWS/GitHub/Slack/OpenAI keys are ignored.

# AMEM_SHOP_ENV=/absolute/path/to/other-project/.env

AMEM_FROM_NAME=amem
# AMEM_FROM_EMAIL=notifications@example.com

# One-time Checkout amounts when you are not using Stripe Price IDs
# STRIPE_AMOUNT_PRO_CENTS=1200
# STRIPE_AMOUNT_IT_CENTS=4900
# Live one-time prices on the Modini Stripe account (not secrets)
STRIPE_PRICE_PRO=price_1U6Zd00xKTMciJ860wtUo1OP
STRIPE_PRICE_IT=price_1U6Zd50xKTMciJ86vNz291kI

# Signing key. Or run: amem license keys --out-dir shop/.data
# AMEM_LICENSE_PRIVKEY=

# From `stripe listen --forward-to localhost:8788/webhook`
# STRIPE_WEBHOOK_SECRET=whsec_...

AMEM_SHOP_PORT=8788
# AMEM_SHOP_URL=http://127.0.0.1:8788

# Seller-only analytics dashboard at /admin (never linked from the public site)
# AMEM_ADMIN_TOKEN=long-random-string
# Optional durable beacons/ + raw/ on App Runner (otherwise local shop/.data/{beacons,raw-requests}.jsonl)
# AMEM_HITS_S3_BUCKET=amem-shop-hits
